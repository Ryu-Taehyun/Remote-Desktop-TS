# PostgreSQL 연결 문자열 (Vercel 에서는 Neon/Vercel Postgres 연동 시 POSTGRES_URL 이 자동 주입됨)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/remote_desktop
# JWT 서명 키 — 반드시 긴 랜덤 문자열로 교체 (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720
# 웹과 API 를 같은 Vercel 도메인에서 서비스하면 CORS 는 필요 없음
CORS_ORIGINS=*
